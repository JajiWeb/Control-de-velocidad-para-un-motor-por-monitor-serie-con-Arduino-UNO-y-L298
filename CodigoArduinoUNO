const int ENA = 9;
const int IN1 = 8;
const int IN2 = 7;

void setup() {
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  Serial.begin(9600);
  
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  
  Serial.println("Ingresa velocidad (0-255):");
}

void loop() {
  if (Serial.available() > 0) {
    int velocidad = Serial.parseInt();
    
    if (velocidad >= 0 && velocidad <= 255) {
      analogWrite(ENA, velocidad);
      Serial.print("Velocidad ajustada a: ");
      Serial.println(velocidad);
    } else {
      Serial.println("Valor fuera de rango (0-255)");
    }
  }
}
